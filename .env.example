# Optional: use OpenAI for Japanese summaries instead of the built-in GitHub Models fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional notification destinations. Store real values in GitHub Actions Secrets.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=

# Public URLs used by the dashboard and notification links.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DIGEST_URL=
PUBLIC_APP_URL=
